# Добавляем кнопки управления игрой в Main.gd

# В _ready() добавьте:
_create_game_controls()

# Добавьте новые функции:
func _create_game_controls() -> void:
	# Кнопка "Завершить ход"
	var end_turn_btn = Button.new()
	end_turn_btn.text = "⏭️ ЗАВЕРШИТЬ ХОД"
	end_turn_btn.position = Vector2(10, get_viewport().size.y - 70)
	end_turn_btn.size = Vector2(200, 60)
	end_turn_btn.add_theme_font_size_override("font_size", 24)
	end_turn_btn.pressed.connect(_on_end_turn_pressed)
	end_turn_btn.visible = false
	end_turn_btn.name = "EndTurnButton"
	add_child(end_turn_btn)

func _on_end_turn_pressed() -> void:
	print("⏭️ Игрок завершил ход!")
	var btn = get_node_or_null("EndTurnButton")
	if btn:
		btn.visible = false
	
	if _game_manager:
		var state = _game_manager.get_state()
		match state:
			GameManager.GameState.SETUP:
				_game_manager.finish_setup()
			GameManager.GameState.PLAYER_TURN:
				_game_manager.finish_player_turn()

func _on_game_state_changed(new_state: int) -> void:
	var btn = get_node_or_null("EndTurnButton")
	if not btn:
		return
	
	match new_state:
		GameManager.GameState.SETUP:
			btn.visible = true
			btn.text = "✅ ГОТОВО (расстановка)"
			if hint:
				hint.text = "👤 Расставьте игроков, затем нажмите 'ГОТОВО'"
		GameManager.GameState.PLAYER_TURN:
			btn.visible = true
			btn.text = "⏭️ ЗАВЕРШИТЬ ХОД"
			if hint:
				hint.text = "🎯 Ваш ход! Двигайте игроков"
		GameManager.GameState.AI_TURN:
			btn.visible = false
			if hint:
				hint.text = "🤖 Ход компьютера..."
		GameManager.GameState.GAME_OVER:
			btn.visible = false
		_:
			btn.visible = false
